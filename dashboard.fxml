<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="20" style="-fx-padding: 30;" alignment="TOP_CENTER">
    <Label text="Receptionist Dashboard" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #2C3E50; -fx-padding: 20; -fx-pref-width: 180; -fx-pref-height: 100;">
            <Label text="Total Guests" style="-fx-text-fill: white; -fx-font-size: 14;"/>
            <Label text="0" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #27AE60; -fx-padding: 20; -fx-pref-width: 180; -fx-pref-height: 100;">
            <Label text="Available Rooms" style="-fx-text-fill: white; -fx-font-size: 14;"/>
            <Label text="0" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E67E22; -fx-padding: 20; -fx-pref-width: 180; -fx-pref-height: 100;">
            <Label text="Active Reservations" style="-fx-text-fill: white; -fx-font-size: 14;"/>
            <Label text="0" style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
</VBox>